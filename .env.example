# ---------- โหมดออฟไลน์: LM Studio ที่รันในเครื่อง ----------
# ชุดเดียวกับที่ใช้ทดลองในสารนิพนธ์ ค่าด้านล่างเป็นค่าเริ่มต้นของ LM Studio อยู่แล้ว
# (LM Studio ไม่ตรวจ API key จริง ใส่อะไรก็ผ่าน)
OFFLINE_BASE_URL=http://127.0.0.1:1234/v1
OFFLINE_API_KEY=lm-studio
# เว้นว่างไว้ = ให้เลือกจากรายชื่อโมเดลที่ LM Studio โหลดไว้จริง ผ่าน dropdown บนหน้าเว็บ
OFFLINE_MODEL=

# ---------- โหมดออนไลน์: ผู้ให้บริการออนไลน์ เช่น OpenRouter ----------
# ไม่ตั้งก็ได้ ถ้าไม่ตั้ง ปุ่ม "ออนไลน์" บนหน้าเว็บจะขึ้นเป็นแบบกดไม่ได้
ONLINE_BASE_URL=https://openrouter.ai/api/v1
ONLINE_API_KEY=sk-or-v1-...
ONLINE_MODEL=openai/gpt-4o-mini

# โหมดที่เลือกไว้ตอนเปิดหน้าเว็บครั้งแรก (offline | online)
# ถ้าโหมดที่ตั้งไว้ยังไม่ได้ตั้งค่า ระบบจะถอยไปใช้อีกโหมดให้เอง
DEFAULT_LLM_MODE=offline

# ใช้เฉพาะตอนไม่ได้ใช้ RAG (RAG_ENABLED=false หรือโหลดดัชนีไม่สำเร็จ)
# ถ้าเปิด RAG ระบบจะใช้เทมเพลตใน services/rag_service.py แทน เพราะต้องแทรกบริบทที่ค้นได้เข้าไปด้วย
# ค่าหลายบรรทัดต้องครอบด้วยเครื่องหมายคำพูดคู่ทั้งก้อน
SYSTEM_PROMPT="คุณคือผู้ช่วยสนับสนุนงานไอทีขององค์กร (IT Support) ทำหน้าที่ช่วยพนักงานแก้ปัญหาการใช้งานระบบงานและแอปพลิเคชันภายใน เช่น การเข้าสู่ระบบ สิทธิ์การใช้งาน ข้อผิดพลาดระหว่างใช้งาน และขั้นตอนการทำงานในระบบ

วิธีตอบ:
- ตอบเป็นภาษาไทย สุภาพ กระชับ ตรงประเด็น
- ถ้าเป็นการแก้ปัญหา ให้ตอบเป็นขั้นตอนที่ทำตามได้จริงเรียงทีละข้อ
- ถ้าข้อมูลไม่พอที่จะช่วยได้ ให้ถามกลับก่อน เช่น ใช้ระบบงานอะไร ข้อความ error ที่ขึ้นคืออะไร หรือทำขั้นตอนไหนอยู่ตอนเกิดปัญหา
- ห้ามเดาหรือแต่งชื่อเมนู ขั้นตอน เบอร์ติดต่อ หรือชื่อผู้ดูแลระบบที่ไม่แน่ใจ ให้บอกตรงๆ ว่าไม่แน่ใจ แล้วแนะนำให้แจ้งทีม IT Support

ความปลอดภัย:
- ห้ามขอรหัสผ่าน รหัส OTP หรือข้อมูลลับจากผู้ใช้ไม่ว่ากรณีใด และถ้าผู้ใช้พิมพ์มาเอง ให้เตือนว่าไม่ควรส่งข้อมูลเหล่านี้ในแชท
- ไม่แนะนำวิธีหลบเลี่ยงระบบความปลอดภัยหรือสิทธิ์การใช้งาน ถ้าผู้ใช้ต้องการสิทธิ์เพิ่ม ให้แนะนำให้ขออนุมัติตามขั้นตอนขององค์กร

การส่งต่อ:
- ถ้าปัญหาเกินขอบเขตที่ช่วยได้ เช่น ต้องแก้ที่ระบบหลังบ้าน ต้องขอสิทธิ์เพิ่ม หรือสงสัยว่าระบบขัดข้องเป็นวงกว้าง ให้สรุปอาการและข้อมูลที่รวบรวมได้ แล้วแนะนำให้แจ้งทีม IT Support เพื่อเปิดเรื่องต่อ
- ถ้าผู้ใช้ถามเรื่องที่ไม่เกี่ยวกับงานไอทีขององค์กร ให้ปฏิเสธอย่างสุภาพและชวนกลับมาที่เรื่องการใช้งานระบบ"

# ---------- ฐานข้อมูล (เก็บประวัติคำถาม-คำตอบ) ----------
DB_ENABLED=true

# ฐานข้อมูลหลักคือ PostgreSQL — ตั้งค่าแยกฟิลด์ ไม่ต้องต่อเป็น URL เอง
# (รหัสผ่านที่มี @ : / # ปนอยู่ โค้ดจะ encode ให้เองตอนประกอบ URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
# disable = ฐานข้อมูลอยู่เครื่องเดียวกัน | require = ต่อข้ามเครือข่ายองค์กร
POSTGRES_SSLMODE=disable

# ใส่ค่านี้เมื่อต้องการระบุ connection string ทั้งเส้นเอง จะข้ามค่า POSTGRES_* ด้านบน
# ปล่อยว่างไว้ในการใช้งานปกติ ตัวอย่าง:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require
#   DATABASE_URL=sqlite:///D:/tmp/chatbot.db     ← ทดสอบเร็วๆ โดยยังไม่มี PostgreSQL
DATABASE_URL=

# ---- connection pool (ใช้กับ PostgreSQL เท่านั้น) ----
# จำนวน connection ที่เปิดค้างไว้ และที่ยืมเพิ่มได้ชั่วคราวตอนคนใช้พร้อมกันเยอะ
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# ทิ้ง connection ที่เปิดมานานเกินกี่วินาที กันโดนไฟร์วอลล์ตัดแล้วค้างอยู่ในพูล
DB_POOL_RECYCLE=1800
# รอเซิร์ฟเวอร์ตอบนานสุดกี่วินาที เกินนี้ถือว่าต่อไม่ได้ (ไม่ให้คำตอบผู้ใช้ค้างรอ)
DB_CONNECT_TIMEOUT=5

# จำนวนรอบย้อนหลังที่ดึงกลับมาเป็นบริบทเมื่อผู้ใช้กลับมาหลังแอปรีสตาร์ท
DB_HISTORY_TURNS=10

# ---------- RAG ----------
RAG_ENABLED=true
RAG_INDEX_DIR=rag_index
RAG_TOP_K=5
RAG_USE_HYBRID=true
RAG_USE_RERANKER=true
RAG_USE_METADATA_FILTER=true
RAG_PROMPT_VARIANT=graded
RAG_PRELOAD=true

# ---------- ชั้นตรวจก่อน-หลังตอบ (Guard Layer) ----------
# ตรวจด้วยกฎที่กำหนดแน่นอน ทำงานในเครื่องทั้งหมด ไม่เรียกโมเดลและไม่ต่อเน็ต
# ปิดได้ด้วย GUARD_ENABLED=false เพื่อเทียบผลว่า "มีชั้นตรวจ" กับ "ไม่มี" ต่างกันอย่างไร
GUARD_ENABLED=true

# ไฟล์คำต้องห้ามของชั้นที่ 1 (แก้ไฟล์แล้วมีผลทันที ไม่ต้องรีสตาร์ท)
GUARD_BLOCKLIST_PATH=guard_blocklist.txt

# ตรวจฝั่งคำตอบด้วยหรือไม่ — เทียบอีเมล/เบอร์โทร/เลข 13 หลักในคำตอบกับบริบทที่ค้นคืนมา
# มีผลเฉพาะโหมดตอบแบบไม่สตรีม
GUARD_CHECK_OUTPUT=true
